<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <UserConfigurations>
        <ColorConfiguration id="themeColor" displayName="theme_label" defaultValue="0">
            <ColorOption id="0" displayName="theme_cyan" colors="#16D7E8 #9AF6FF" />
            <ColorOption id="1" displayName="theme_green" colors="#18D86B #91F5B8" />
            <ColorOption id="2" displayName="theme_lime" colors="#B6F21B #E4FF8A" />
            <ColorOption id="3" displayName="theme_yellow" colors="#F3D522 #FFF29A" />
            <ColorOption id="4" displayName="theme_orange" colors="#F19A28 #FFD1A0" />
            <ColorOption id="5" displayName="theme_red" colors="#EF5360 #FFADB4" />
            <ColorOption id="6" displayName="theme_pink" colors="#EE67B2 #FFC0E3" />
            <ColorOption id="7" displayName="theme_purple" colors="#9A72F5 #D7C5FF" />
            <ColorOption id="8" displayName="theme_white" colors="#F1F3F5 #BFC5CC" />
            <ColorOption id="9" displayName="theme_steel" colors="#8FA39A #CBD8D2" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene>
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="#080A0D" />
            </Rectangle>
        </PartDraw>

        <PartDraw x="54" y="72" width="342" height="5" alpha="230">
            <RoundRectangle x="0" y="0" width="342" height="5" cornerRadiusX="2.5" cornerRadiusY="2.5">
                <Fill color="[CONFIGURATION.themeColor.0]" />
            </RoundRectangle>
            <Variant mode="AMBIENT" target="alpha" value="90" />
        </PartDraw>

        <PartText x="52" y="88" width="346" height="132">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="116" weight="LIGHT" slant="NORMAL" color="#F5F7F8">
                    <Template>%s
                        <Parameter expression="[HOUR_MINUTE]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="75" y="202" width="300" height="40">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="25" weight="NORMAL" slant="NORMAL" color="[CONFIGURATION.themeColor.1]">
                    <Template>%s  %s %s
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH_S]" />
                        <Parameter expression="[DAY]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="36" y="260" width="108" height="108">
            <Ellipse x="0" y="0" width="108" height="108"><Fill color="#14181D" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        <PartDraw x="36" y="260" width="108" height="108">
            <Ellipse x="3" y="3" width="102" height="102"><Stroke color="[CONFIGURATION.themeColor.0]" thickness="2" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="120" />
        </PartDraw>

        <PartDraw x="171" y="260" width="108" height="108">
            <Ellipse x="0" y="0" width="108" height="108"><Fill color="#14181D" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        <PartDraw x="171" y="260" width="108" height="108">
            <Ellipse x="3" y="3" width="102" height="102"><Stroke color="[CONFIGURATION.themeColor.0]" thickness="2" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="120" />
        </PartDraw>

        <PartDraw x="306" y="260" width="108" height="108">
            <Ellipse x="0" y="0" width="108" height="108"><Fill color="#14181D" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        <PartDraw x="306" y="260" width="108" height="108">
            <Ellipse x="3" y="3" width="102" height="102"><Stroke color="[CONFIGURATION.themeColor.0]" thickness="2" /></Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="120" />
        </PartDraw>

        <ComplicationSlot slotId="1" displayName="left_slot" supportedTypes="SHORT_TEXT EMPTY" isCustomizable="true" x="28" y="252" width="124" height="124">
            <BoundingOval x="0" y="0" width="124" height="124" />
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="12" y="34" width="100" height="58">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="31" weight="NORMAL" color="#F5F7F8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" displayName="middle_slot" supportedTypes="SHORT_TEXT EMPTY" isCustomizable="true" x="163" y="252" width="124" height="124">
            <BoundingOval x="0" y="0" width="124" height="124" />
            <Complication type="SHORT_TEXT">
                <PartText x="12" y="34" width="100" height="58">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="31" weight="NORMAL" color="#F5F7F8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="right_slot" supportedTypes="SHORT_TEXT EMPTY" isCustomizable="true" x="298" y="252" width="124" height="124">
            <BoundingOval x="0" y="0" width="124" height="124" />
            <Complication type="SHORT_TEXT">
                <PartText x="12" y="34" width="100" height="58">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="31" weight="NORMAL" color="#F5F7F8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <PartText x="145" y="386" width="160" height="30" alpha="165">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="18" weight="LIGHT" color="#D7DADF">APEX</Font>
            </Text>
            <Variant mode="AMBIENT" target="alpha" value="70" />
        </PartText>
    </Scene>
</WatchFace>
